# EduMaster.ai Enterprise Backend Environment Variables
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=cambiar_por_clave_secreta_de_32_caracteres_o_mas

# En Railway, DATABASE_URL y REDIS_URL se inyectan automáticamente al agregar los plugins
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/edumaster_db
REDIS_URL=redis://localhost:6379/0

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://edumaster-ai.vercel.app
