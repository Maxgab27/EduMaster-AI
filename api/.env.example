# Supabase (REST / PostgREST). Si falta alguna variable, la API usa almacenamiento DEMO en memoria.
SUPABASE_URL=
SUPABASE_KEY=

# Orígenes permitidos por CORS, separados por coma. En Vercel usa el dominio real.
CORS_ORIGINS=http://localhost:5173

# Base pública para el QR de certificados (sin barra final).
PUBLIC_VERIFY_BASE_URL=https://TU_BACKEND.railway.app/api/v1/certificates/verify

# Fase 4: autoridad DEMO por headers (NO es autenticación real).
# 1 = devolver 403 cuando el rol no tiene permiso; 0 = solo auditar la denegación.
RBAC_ENFORCE=1
# Rol usado cuando el navegador no envía X-Role o envía un valor desconocido.
DEMO_DEFAULT_ROLE=estudiante
# Tenant DEMO para settings y auditoría.
TENANT_ID=org-ute-peru-2026
