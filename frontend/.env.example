# Base URL de la API (sin barra final). Ejemplo: http://127.0.0.1:8000
# Si se deja vacío, el frontend usa el adaptador DEMO incluido en src/services/.
VITE_API_BASE_URL=

# Núcleo real por HTTP: riesgo de abandono, SpeedGrader, firma y auditoría.
# Apunta al backend activo en 127.0.0.1:8000. Vacío = adaptador DEMO local.
VITE_CORE_API_BASE_URL=http://127.0.0.1:8000
